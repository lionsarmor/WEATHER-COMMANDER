; Per-country personal station, shared by native search and weather workers.
direct_locations {
    &ubyte[12] us_lat=$9890
    &ubyte[12] us_lon=$989c
    &ubyte[16] us_name=$98a8
    &ubyte[12] ph_lat=$98b8
    &ubyte[12] ph_lon=$98c4
    &ubyte[16] ph_name=$98d0
    &bool us_set=$98e0
    &bool ph_set=$98e1
}
